{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolveReport",
  "description": "求解报告：结局 + 求解后的实体 + 诊断。",
  "type": "object",
  "properties": {
    "diagnostics": {
      "$ref": "#/$defs/Diagnostics"
    },
    "entities": {
      "description": "求解后的实体。欠约束时是解集中的一个特解。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "outcome": {
      "$ref": "#/$defs/SolveOutcome"
    }
  },
  "additionalProperties": false,
  "required": [
    "outcome",
    "entities",
    "diagnostics"
  ],
  "$defs": {
    "ConstraintGroup": {
      "description": "一组相互牵连的约束。出现在两个位置，含义不同：\n\n- `Diagnostics::conflicts`：组内约束不可能同时满足；\n- `Diagnostics::redundant_constraints`：组内约束相互一致但线性相关，\n  在当前位形的线性化中不增加秩；删除后须重新验证几何行为。",
      "type": "object",
      "properties": {
        "constraint_ids": {
          "description": "组内约束 id（按模型中的顺序）。",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "human_message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "constraint_ids",
        "human_message"
      ]
    },
    "ConstraintResidual": {
      "description": "单条约束在返回解（或特解）处的残差。",
      "type": "object",
      "properties": {
        "constraint_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "human_message": {
          "type": "string"
        },
        "residual": {
          "description": "残差值（约束方程左端减右端；距离约束即 `‖p‖ − d`）。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "residual",
        "human_message"
      ]
    },
    "Diagnostics": {
      "description": "结构化诊断。",
      "type": "object",
      "properties": {
        "conflicts": {
          "description": "冲突组：组内约束不可能同时满足。非空 ⇔ 结局为 `Inconsistent`。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintGroup"
          }
        },
        "dof_remaining": {
          "description": "返回位形处的剩余自由度：自由参数数 − rank(J)。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "dof_total": {
          "description": "模型总自由度（各实体参数数之和）。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "iterations": {
          "description": "实际执行的迭代数（2D 闭式路径恒为 0）。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "jacobian_condition_estimate": {
          "description": "雅可比条件数估计：`κ(J) = σ_max / σ_min(非零)`。\n3D 取自局部旋转切空间、平移/旋转三元组尺度均衡后的终态雅可比；\n这是均衡矩阵的非零谱条件数，不能代表原始物理单位下的条件数。\n2D 闭式路径对单条约束精确为 `1.0`，\n行退化（原点处梯度为零）或重复约束时为 `None`。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "joints": {
          "description": "关节变量状态（revolute/cylindrical/prismatic 各报一条）。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JointState"
          }
        },
        "max_residual": {
          "description": "残差绝对值最大的那条约束。",
          "anyOf": [
            {
              "$ref": "#/$defs/ConstraintResidual"
            },
            {
              "type": "null"
            }
          ]
        },
        "redundant_constraints": {
          "description": "冗余组：组内约束一致但线性相关（与约束书写顺序无关）。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintGroup"
          }
        },
        "residuals": {
          "description": "每条约束在返回解处的残差。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintResidual"
          }
        },
        "suggestions": {
          "description": "机器可读的修复建议。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Suggestion"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "dof_total",
        "dof_remaining",
        "iterations",
        "conflicts",
        "redundant_constraints",
        "residuals",
        "suggestions",
        "joints"
      ]
    },
    "Entity": {
      "description": "模型中的一个实体：稳定 id + 几何数据。",
      "type": "object",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "geometry"
      ]
    },
    "Geometry": {
      "description": "几何实体。每个变体自带全部几何参数（不做参数共享/引用式建模）。",
      "oneOf": [
        {
          "description": "平面上的点（2 DOF）。",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "point2"
            },
            "x": {
              "type": "number",
              "format": "double"
            },
            "y": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y"
          ]
        },
        {
          "description": "线段，由两端点表示（4 DOF）。",
          "type": "object",
          "properties": {
            "end": {
              "$ref": "#/$defs/Point2"
            },
            "start": {
              "$ref": "#/$defs/Point2"
            },
            "type": {
              "type": "string",
              "const": "line2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "end"
          ]
        },
        {
          "description": "圆（3 DOF：圆心 2 + 半径 1）。",
          "type": "object",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point2"
            },
            "radius": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "circle2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "center",
            "radius"
          ]
        },
        {
          "description": "圆弧（5 DOF：圆 3 + 起止角 2），角度为弧度。",
          "type": "object",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point2"
            },
            "end_angle": {
              "type": "number",
              "format": "double"
            },
            "radius": {
              "type": "number",
              "format": "double"
            },
            "start_angle": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "arc2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "center",
            "radius",
            "start_angle",
            "end_angle"
          ]
        },
        {
          "description": "3D 刚体（6 DOF），位姿用 [`Pose3`]（平移 + 指数映射旋转）。",
          "type": "object",
          "properties": {
            "pose": {
              "$ref": "#/$defs/Pose3"
            },
            "type": {
              "type": "string",
              "const": "rigid3"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "pose"
          ]
        }
      ]
    },
    "JointState": {
      "description": "关节变量的当前值（按关节约束逐个报告，机器人学的一等公民）。\n\nrevolute/cylindrical：绕轴转角 θ（弧度，主值 (−π, π]，零位由\n`a_ref`/`b_ref` 定义）；prismatic：沿轴位移 δ（长度）。两者都只依赖\n返回的位姿，`drive` 收敛后该值即驱动目标。",
      "type": "object",
      "properties": {
        "constraint_id": {
          "description": "对应的关节约束 id。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "human_message": {
          "type": "string"
        },
        "joint_kind": {
          "description": "\"revolute\" | \"cylindrical\" | \"prismatic\"",
          "type": "string"
        },
        "value": {
          "description": "当前关节变量（弧度或长度），只由返回的位姿决定。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "joint_kind",
        "value",
        "human_message"
      ]
    },
    "Point2": {
      "description": "2D 点。",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "Pose3": {
      "description": "3D 刚体位姿 = 平移 + 旋转（指数映射）。",
      "type": "object",
      "properties": {
        "rotation": {
          "$ref": "#/$defs/Rotation3"
        },
        "translation": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation"
      ]
    },
    "Rotation3": {
      "description": "3D 旋转的参数化：**指数映射（旋转向量）** `v = θ·û`。\n\nJSON 使用紧凑的三维旋转向量。它是姿态存储格式，并非全局无奇异\n的求解坐标：2π 等位置的全局参数雅可比会退化。\n求解内部采用三维 SO(3) 局部增量并复合旋转，DOF 分析也使用该切空间。\n四元数存储配合三维局部增量同样无需添加单位范数约束。\n\n# 切换抽象点\n\n本类型是旋转参数化的唯一入口：求解器只经由 `Rotation3`（及其未来的\n切空间/雅可比接口）访问旋转，不直接触碰内部表示。若后续需要换成\n四元数 + 流形投影等表示，只需替换本结构体与对应的导数实现，\n数据模型其余部分不动。",
      "type": "object",
      "properties": {
        "vector": {
          "description": "旋转向量：方向为旋转轴（单位化后），模长为旋转角（弧度）。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "vector"
      ]
    },
    "SolveOutcome": {
      "description": "求解结局：只回答「返回的位形是否满足全部约束」。这是**求解层**的结果\n（区别于工具层错误 [`crate::SolveError`]）。\n\n欠约束（`diagnostics.dof_remaining > 0`）与冗余\n（`diagnostics.redundant_constraints` 非空）是与结局正交的事实，\n不折叠进本枚举：一个完美满足但仍可拖动的草图就是 `Converged`。",
      "oneOf": [
        {
          "description": "在容差内满足全部约束。",
          "type": "string",
          "const": "converged"
        },
        {
          "description": "约束互相冲突：`diagnostics.conflicts` 给出冲突组与修复建议。",
          "type": "string",
          "const": "inconsistent"
        },
        {
          "description": "未收敛，且未能证明冲突（迭代上限、退化初值或非线性停滞）。",
          "type": "string",
          "const": "not_converged"
        }
      ]
    },
    "Suggestion": {
      "description": "一条诊断建议：机器可读动作 + 人类/LLM 可读解释。\n\nJSON 形状（flatten 拍平，便于人与 LLM 直接阅读）：\n`{\"action\":\"remove_constraint\",\"id\":5,\"human_message\":\"…\"}`。\n注意 serde 的 flatten 与 deny_unknown_fields 不兼容，故本类型不加该属性。",
      "type": "object",
      "properties": {
        "human_message": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "description": "删除指定约束（冗余，或冲突组中的多余一方）。",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "remove_constraint"
            },
            "id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "action",
            "id"
          ]
        },
        {
          "description": "放宽指定约束（调整参数值使其与其余约束相容）。",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "relax_constraint"
            },
            "id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "action",
            "id"
          ]
        },
        {
          "description": "补充约束以消除 `dof_remaining` 个剩余自由度。",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "add_constraint"
            },
            "dof_remaining": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "action",
            "dof_remaining"
          ]
        }
      ],
      "required": [
        "human_message"
      ]
    },
    "Vec3": {
      "description": "3D 向量（平移、方向等）。",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ]
    }
  }
}
