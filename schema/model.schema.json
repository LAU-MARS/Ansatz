{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "description": "求解器输入：实体 + 约束 + 参数。",
  "type": "object",
  "properties": {
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Constraint"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "params": {
      "$ref": "#/$defs/SolveParams",
      "default": {
        "max_iterations": 100,
        "tolerance": 1e-9
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "entities",
    "constraints"
  ],
  "$defs": {
    "Axis3": {
      "description": "3D 装配用的**体坐标系**轴：过 origin、方向 direction（不必单位化，求解时归一）。",
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Vec3"
        },
        "origin": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "direction"
      ]
    },
    "Constraint": {
      "description": "模型中的一条约束：稳定 id（模型内唯一）+ 种类参数 + 可选人类标签。",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ]
    },
    "ConstraintKind": {
      "description": "约束种类与参数。\n\n2D 草图约束与 3D 装配约束共用本枚举。2D 路径目前只支持\n[`ConstraintKind::Distance`] 的 `b = None`（到原点）形式；3D 路径支持\ndistance / angle / fixed / mate / coaxial / 关节族 / transmission。\n其余组合会被 [`crate::solve`](crate::solver::solve) 以\n[`SolveError::UnsupportedConstraint`](crate::report::SolveError::UnsupportedConstraint)\n拒绝——这是「能力未实现」的工具级错误，不是求解失败。",
      "oneOf": [
        {
          "description": "两实体重合（点-点，或点落在曲线/曲面上）。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "coincident"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b"
          ]
        },
        {
          "description": "三点共线（c 落在 a、b 确定的直线上）。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "c": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "collinear"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "c"
          ]
        },
        {
          "description": "两直线平行。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "parallel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b"
          ]
        },
        {
          "description": "两元素垂直。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "perpendicular"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b"
          ]
        },
        {
          "description": "相切。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "tangent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b"
          ]
        },
        {
          "description": "距离。2D：`b = None` 表示到坐标原点。3D 装配：a、b 为两个 Rigid3，\n距离在**锚点**之间测量（体坐标系；缺省为各自原点）。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_anchor": {
              "description": "a 体上的锚点（体坐标系）；缺省 (0,0,0)。",
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "b": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "b_anchor": {
              "description": "b 体上的锚点（体坐标系）；缺省 (0,0,0)。",
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "distance"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "value"
          ]
        },
        {
          "description": "角度（弧度）。2D：`b = None` 表示相对参考系（未实现）。\n3D 装配：a、b 为两个 Rigid3，`a_dir`/`b_dir` 为非零参考方向\n（求解时归一化）。容差按真实夹角误差（弧度）检查；0/π 的方向对齐\n消去两个转动自由度，其他角度通常消去一个。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_dir": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "b": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "b_dir": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "angle"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "value"
          ]
        },
        {
          "description": "a 与 b 关于 about（点/线/面）对称。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "about": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "symmetric"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "about"
          ]
        },
        {
          "description": "固定 a 的当前位形（不参与求解，自由度被结构性消去）。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "fixed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a"
          ]
        },
        {
          "description": "3D 装配：两面贴合——两面在世界系重合且法向相反（消 3 个自由度：\n法向平移 1 + 法向转动 2）。平面几何在各自**体坐标系**内给出。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_plane": {
              "description": "a 体上的贴合面（体坐标系）。",
              "$ref": "#/$defs/Plane3"
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b_plane": {
              "description": "b 体上的贴合面（体坐标系）。",
              "$ref": "#/$defs/Plane3"
            },
            "type": {
              "type": "string",
              "const": "mate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "a_plane",
            "b_plane"
          ]
        },
        {
          "description": "3D 装配：同轴——两轴共线且同向（消 4 个自由度：横向平移 2 + 偏轴转动 2；\n沿轴滑动与绕轴转动仍自由）。轴几何在各自**体坐标系**内给出。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_axis": {
              "description": "a 体上的轴（体坐标系）。",
              "$ref": "#/$defs/Axis3"
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b_axis": {
              "description": "b 体上的轴（体坐标系）。",
              "$ref": "#/$defs/Axis3"
            },
            "type": {
              "type": "string",
              "const": "coaxial"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "a_axis",
            "b_axis"
          ]
        },
        {
          "description": "3D 装配：**转动副**（revolute）——同轴 + 轴向锚点间距锁定，\n消 5 留 1（绕轴转动）。`offset` 为两轴原点沿轴的间距（缺省 0）。\n\n关节角 θ 是**位姿的函数**：从 `R_a·a_ref` 绕 a 轴转到 `R_b·b_ref` 的\n有向角，取主值 (−π, π]。`a_ref`/`b_ref` 是各自体坐标系内的零位参考\n方向（会被投影到垂直于轴的平面再归一）；缺省时按轴方向确定性地选取。\n`drive` 是 θ 的绝对目标（弧度），因此把求解结果原样再解一次不会移动。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_axis": {
              "$ref": "#/$defs/Axis3"
            },
            "a_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b_axis": {
              "$ref": "#/$defs/Axis3"
            },
            "b_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "drive": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "offset": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "revolute"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "a_axis",
            "b_axis"
          ]
        },
        {
          "description": "3D 装配：**圆柱副**（cylindrical）——同轴，消 4 留 2\n（沿轴滑动 + 绕轴转动）。约束行与 coaxial 相同，诊断按关节报告 θ，\nθ 的定义与零位参考同 revolute。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_axis": {
              "$ref": "#/$defs/Axis3"
            },
            "a_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b_axis": {
              "$ref": "#/$defs/Axis3"
            },
            "b_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "cylindrical"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "a_axis",
            "b_axis"
          ]
        },
        {
          "description": "3D 装配：**移动副**（prismatic）——圆柱副 + 姿态滚转锁定，\n消 5 留 1（沿轴平动）。滚转通过一对垂直于轴的参考方向锁定\n（`roll` 为绕 a 轴的有向夹角目标，取 [0, π]，弧度）。\na_ref/b_ref/roll 必须一起给出；全部缺省则确定性选取参考方向并锁定 roll=0。\n参考方向先投影到各自轴的法平面并归一化。\n关节变量 δ = (b 轴原点 − a 轴原点)·(a 轴方向)，世界系下的有向距离；\n`drive` 是 δ 的绝对目标。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_axis": {
              "$ref": "#/$defs/Axis3"
            },
            "a_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b_axis": {
              "$ref": "#/$defs/Axis3"
            },
            "b_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Vec3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "drive": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "roll": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "prismatic"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "a_axis",
            "b_axis"
          ]
        },
        {
          "description": "3D 装配：**球副**（spherical）——两锚点重合，消 3 留 3（姿态自由）。",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "a_point": {
              "description": "a 体上的球心锚点（体坐标系）。",
              "$ref": "#/$defs/Vec3"
            },
            "b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "b_point": {
              "description": "b 体上的球心锚点（体坐标系）。",
              "$ref": "#/$defs/Vec3"
            },
            "type": {
              "type": "string",
              "const": "spherical"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "a",
            "b",
            "a_point",
            "b_point"
          ]
        },
        {
          "description": "3D 装配：**传动耦合**（齿轮/带轮）——两个已存在的 revolute 关节的\n关节变量按速比联动：`θ_b = ratio · θ_a`（θ 为 revolute 文档定义的\n绝对关节角；残差折回 (−π, π]）。两个关节的零位由各自的\n`a_ref`/`b_ref` 决定。`joint_a`/`joint_b` 是两个不同 revolute 约束的 id。",
          "type": "object",
          "properties": {
            "joint_a": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "joint_b": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ratio": {
              "description": "速比：θ_b 每随 θ_a 变化 1 弧度变化 ratio 弧度（外啮合为负）。",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "transmission"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "joint_a",
            "joint_b",
            "ratio"
          ]
        }
      ]
    },
    "Entity": {
      "description": "模型中的一个实体：稳定 id + 几何数据。",
      "type": "object",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "geometry"
      ]
    },
    "Geometry": {
      "description": "几何实体。每个变体自带全部几何参数（不做参数共享/引用式建模）。",
      "oneOf": [
        {
          "description": "平面上的点（2 DOF）。",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "point2"
            },
            "x": {
              "type": "number",
              "format": "double"
            },
            "y": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y"
          ]
        },
        {
          "description": "线段，由两端点表示（4 DOF）。",
          "type": "object",
          "properties": {
            "end": {
              "$ref": "#/$defs/Point2"
            },
            "start": {
              "$ref": "#/$defs/Point2"
            },
            "type": {
              "type": "string",
              "const": "line2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "end"
          ]
        },
        {
          "description": "圆（3 DOF：圆心 2 + 半径 1）。",
          "type": "object",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point2"
            },
            "radius": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "circle2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "center",
            "radius"
          ]
        },
        {
          "description": "圆弧（5 DOF：圆 3 + 起止角 2），角度为弧度。",
          "type": "object",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point2"
            },
            "end_angle": {
              "type": "number",
              "format": "double"
            },
            "radius": {
              "type": "number",
              "format": "double"
            },
            "start_angle": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "arc2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "center",
            "radius",
            "start_angle",
            "end_angle"
          ]
        },
        {
          "description": "3D 刚体（6 DOF），位姿用 [`Pose3`]（平移 + 指数映射旋转）。",
          "type": "object",
          "properties": {
            "pose": {
              "$ref": "#/$defs/Pose3"
            },
            "type": {
              "type": "string",
              "const": "rigid3"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "pose"
          ]
        }
      ]
    },
    "Plane3": {
      "description": "3D 装配用的**体坐标系**平面：过 origin、法向 normal（不必单位化，求解时归一）。",
      "type": "object",
      "properties": {
        "normal": {
          "$ref": "#/$defs/Vec3"
        },
        "origin": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "normal"
      ]
    },
    "Point2": {
      "description": "2D 点。",
      "type": "object",
      "properties": {
        "x": {
